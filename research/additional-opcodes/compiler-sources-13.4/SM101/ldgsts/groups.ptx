// sass: LDGSTS LDGDEPBAR DEPBAR
.version 9.4
.target sm_110
.address_size 64
.visible .entry groups(.param .u64 in, .param .u64 out) {
.shared .align 16 .b8 scratch[512];
.reg .b32 %r<4>; .reg .b64 %rd<4>;
ld.param.u64 %rd0, [in]; ld.param.u64 %rd1, [out];
mov.u32 %r0, %tid.x;
shl.b32 %r1, %r0, 2;
cvt.u64.u32 %rd2, %r1;
add.u64 %rd0, %rd0, %rd2;
add.u64 %rd1, %rd1, %rd2;
mov.u32 %r2, scratch;
add.u32 %r2, %r2, %r1;
cp.async.ca.shared.global [%r2], [%rd0], 4;
cp.async.commit_group;
add.u32 %r3, %r2, 128;
cp.async.ca.shared.global [%r3], [%rd0], 4;
cp.async.commit_group;
cp.async.wait_group 1;
ld.shared.u32 %r1, [%r2];
cp.async.wait_group 0;
ld.shared.u32 %r3, [%r3];
add.u32 %r1, %r1, %r3;
st.global.u32 [%rd1], %r1;
ret;
}
