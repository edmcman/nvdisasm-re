// sass: HMMA.1688.F16
.version 9.4
.target sm_89
.address_size 64
.visible .entry half_output8(.param .u64 a, .param .u64 b, .param .u64 c, .param .u64 out) {
.reg .b32 %a<2>, %b, %c<2>, %d<2>;
.reg .b64 %pa, %pb, %pc, %po, %offset;
.reg .u32 %lane;
ld.param.u64 %pa, [a]; ld.param.u64 %pb, [b];
ld.param.u64 %pc, [c]; ld.param.u64 %po, [out];
mov.u32 %lane, %laneid;
mul.wide.u32 %offset, %lane, 8;
add.u64 %pa, %pa, %offset; add.u64 %pc, %pc, %offset; add.u64 %po, %po, %offset;
mul.wide.u32 %offset, %lane, 4; add.u64 %pb, %pb, %offset;
ld.global.v2.b32 {%a0,%a1}, [%pa];
ld.global.b32 %b, [%pb];
ld.global.v2.b32 {%c0,%c1}, [%pc];
mma.sync.aligned.m16n8k8.row.col.f16.f16.f16.f16
{%d0,%d1}, {%a0,%a1}, {%b}, {%c0,%c1};
st.global.v2.b32 [%po], {%d0,%d1};
ret;
}
