// sass: CCTL
.version 9.0
.target sm_103
.address_size 64
.visible .entry prefetch(.param .u64 address, .param .u64 out) {
.reg .b32 %r<2>; .reg .b64 %rd<3>;
ld.param.u64 %rd0, [address]; ld.param.u64 %rd1, [out];
mov.u32 %r0, %tid.x;
mul.wide.u32 %rd2, %r0, 4;
add.u64 %rd0, %rd0, %rd2;
prefetch.global.L1 [%rd0];
prefetch.global.L2 [%rd0];
ld.global.u32 %r1, [%rd0];
add.u64 %rd1, %rd1, %rd2;
st.global.u32 [%rd1], %r1;
ret;
}
