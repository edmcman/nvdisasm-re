// sass: ATOMG MEMBAR
.version 9.0
.target sm_100
.address_size 64
.visible .entry integer_atomic(.param .u64 address, .param .u64 out) {
.reg .b32 %r<3>; .reg .b64 %rd<4>;
ld.param.u64 %rd0, [address]; ld.param.u64 %rd1, [out];
mov.u32 %r0, %tid.x;
atom.global.add.u32 %r1, [%rd0], %r0;
atom.global.cas.b32 %r2, [%rd0], %r1, %r0;
membar.gl;
mul.wide.u32 %rd2, %r0, 4;
add.u64 %rd3, %rd1, %rd2;
add.u32 %r1, %r1, %r2;
st.global.u32 [%rd3], %r1;
ret;
}
