// sass: CCTL
.version 9.4
.target sm_90
.address_size 64
.visible .entry cache_control(.param .u64 address, .param .u64 out) {
.reg .b32 %r<2>;
.reg .b64 %rd<4>;
ld.param.u64 %rd0, [address];
ld.param.u64 %rd1, [out];
mov.u32 %r0, %tid.x;
mul.wide.u32 %rd2, %r0, 128;
add.u64 %rd0, %rd0, %rd2;
ld.global.u32 %r1, [%rd0];
prefetch.global.L2::evict_normal [%rd0];
mul.wide.u32 %rd2, %r0, 4;
add.u64 %rd1, %rd1, %rd2;
st.global.u32 [%rd1], %r1;
ret;
}
