// sass: CCTL YIELD
.version 9.0
.target sm_89
.address_size 64
.visible .entry acquire_loop(.param .u64 flag, .param .u64 out) {
.reg .pred %p<3>;
.reg .b32 %r<5>;
.reg .b64 %rd<3>;
ld.param.u64 %rd0, [flag];
ld.param.u64 %rd1, [out];
mov.u32 %r0, %tid.x;
mov.u32 %r2, 0;
setp.eq.u32 %p0, %r0, 0;
@%p0 bra producer;
loop:
add.u32 %r2, %r2, 1;
ld.acquire.cta.global.u32 %r1, [%rd0];
setp.ne.u32 %p1, %r1, 0;
@%p1 bra done;
setp.lt.u32 %p2, %r2, 1024;
@%p2 bra loop;
bra done;
producer:
mov.u32 %r1, 1;
st.release.gpu.global.u32 [%rd0], %r1;
done:
mul.wide.u32 %rd2, %r0, 8;
add.u64 %rd1, %rd1, %rd2;
st.global.u32 [%rd1], %r1;
st.global.u32 [%rd1+4], %r2;
ret;
}
