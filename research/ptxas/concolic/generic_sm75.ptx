.version 8.7
.target sm_75
.address_size 64
.visible .entry arithmetic(.param .u32 a, .param .u32 b, .param .u64 out) {
.reg .b32 %r<16>; .reg .b64 %rd<8>; .reg .pred %p<8>;
.shared .align 8 .b8 scratch[128];
ld.param.u32 %r0, [a]; ld.param.u32 %r1, [b]; ld.param.u64 %rd0, [out];
add.u32 %r2, %r0, %r1; st.global.u32 [%rd0], %r2; ret;
}
