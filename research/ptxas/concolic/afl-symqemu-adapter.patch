+/* Validate both regular AFL mutations and concolic candidates before execution. */
+size_t afl_custom_post_process(my_mutator_t *data, u8 *buf, size_t size,
+                              u8 **out_buf) {
+  *out_buf = buf;
+  if (!getenv("PTX_VALIDATE_GENERATED") || !data->input_file) return size;
+  int fd = open((char *)data->input_file, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+  if (fd < 0) return 0;
+  size_t written = 0;
+  while (written < size) {
+    ssize_t count = write(fd, buf + written, size - written);
+    if (count <= 0) { close(fd); return 0; }
+    written += count;
+  }
+  close(fd);
+  int pid = fork();
+  if (pid < 0) return 0;
+  if (pid == 0) {
+    dup2(data->afl->fsrv.dev_null_fd, 1);
+    dup2(data->afl->fsrv.dev_null_fd, 2);
+    execv((char *)data->target, (char **)&data->argv[1]);
+    _exit(127);
+  }
+  int status = 0;
+  u64 deadline = get_cur_time() + 3000;
+  while (waitpid(pid, &status, WNOHANG) == 0) {
+    if (get_cur_time() > deadline) {
+      kill(pid, SIGKILL);
+      waitpid(pid, &status, 0);
+      return 0;
+    }
+    usleep(1000);
+  }
+  return WIFEXITED(status) && WEXITSTATUS(status) == 0 ? size : 0;
+}
