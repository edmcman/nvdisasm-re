.version 8.7
.target sm_100
.address_size 64
.visible .entry mad_wide_u32(.param .u32 a, .param .u32 b, .param .u64 c, .param .u64 out) {
.reg .b32 %r<4>; .reg .b64 %rd<3>;
ld.param.u32 %r0, [a]; ld.param.u32 %r1, [b];
ld.param.u64 %rd1, [c]; ld.param.u64 %rd0, [out];
mad.wide.u32 %rd2, %r0, %r1, %rd1;
st.global.u64 [%rd0], %rd2; ret;
}
