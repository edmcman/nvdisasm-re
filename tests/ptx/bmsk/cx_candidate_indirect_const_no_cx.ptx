.version 8.7
.target sm_89
.address_size 64
.visible .entry probe(.param .u64 .ptr.const.align 16 ptr, .param .u64 out) {
.reg .b32 %r<4>; .reg .b64 %rd<2>;
mov.u32 %r0, %tid.x;
ld.param.u64 %rd1, [ptr];
ld.const.u32 %r1, [%rd1];
ld.param.u64 %rd0, [out];
// Negative CX probe: ptxas keeps this constant load separate from BMSK.
/* BEGIN_INSTRUCTION */
bmsk.clamp.b32 %r2, %r0, %r1;
/* END_INSTRUCTION */
st.global.u32 [%rd0], %r2;
ret;
}
