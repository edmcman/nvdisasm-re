// sass: BMSK
.version 8.7
.target sm_89
.address_size 64
.visible .entry bmsk_clamp(.param .u32 a, .param .u32 b, .param .u64 out) {
.reg .b32 %r<5>; .reg .b64 %rd<1>;
ld.param.u32 %r0, [a]; ld.param.u32 %r1, [b]; ld.param.u64 %rd0, [out];
mov.u32 %r3, %tid.x; mov.u32 %r4, %tid.y;
xor.b32 %r0, %r0, %r3; xor.b32 %r1, %r1, %r4;
/* BEGIN_INSTRUCTION */
bmsk.clamp.b32 %r2, %r0, %r1;
/* END_INSTRUCTION */
st.global.u32 [%rd0], %r2; ret;
}
