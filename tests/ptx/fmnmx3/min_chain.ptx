.version 8.7
.target sm_100
.address_size 64
.visible .entry fmnmx3_probe(
    .param .u64 in_ptr,
    .param .u64 out_ptr
)
{
    .reg .b64 %rd<3>;
    .reg .f32 %f<6>;
    ld.param.u64 %rd1, [in_ptr];
    ld.param.u64 %rd2, [out_ptr];
    ld.global.f32 %f1, [%rd1];
    ld.global.f32 %f2, [%rd1+4];
    ld.global.f32 %f3, [%rd1+8];
    min.f32 %f4, %f1, %f2;
    min.f32 %f5, %f4, %f3;
    st.global.f32 [%rd2], %f5;
    ret;
}
