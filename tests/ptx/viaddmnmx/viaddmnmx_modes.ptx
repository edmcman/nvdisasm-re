.version 8.8
.target sm_100
.address_size 64
.visible .entry viaddmnmx_s32_min(
 .param .u64 outp, .param .u32 a, .param .u32 b, .param .u32 c
) {
 .reg .b64 %rd<2>; .reg .b32 %r<5>;
 ld.param.u64 %rd0, [outp]; ld.param.u32 %r0, [a];
 ld.param.u32 %r1, [b]; ld.param.u32 %r2, [c];
 add.s32 %r3, %r0, %r1; min.s32 %r4, %r3, %r2;
 st.global.u32 [%rd0], %r4; ret;
}
