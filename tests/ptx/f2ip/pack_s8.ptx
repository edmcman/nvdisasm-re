.version 8.7
.target sm_89
.address_size 64
.visible .entry f2ip_probe(
    .param .u64 in_ptr,
    .param .u64 out_ptr
)
{
    .reg .b64 %rd<3>;
    .reg .f32 %f<3>;
    .reg .s32 %r<4>;
    ld.param.u64 %rd1, [in_ptr];
    ld.param.u64 %rd2, [out_ptr];
    ld.global.f32 %f1, [%rd1];
    ld.global.f32 %f2, [%rd1+4];
    cvt.rni.s32.f32 %r1, %f1;
    cvt.rni.s32.f32 %r2, %f2;
    cvt.pack.sat.s8.s32.b32 %r3, %r1, %r2, 0;
    st.global.u32 [%rd2], %r3;
    ret;
}
