// sass: LD.E
.version 8.7
.target sm_89
.address_size 64

.visible .entry generic_u32(.param .u64 output, .param .u32 address)
{
    .reg .b32 %r<5>;
    .reg .b64 %rd<4>;
    ld.param.u64 %rd0, [output];
    ld.param.u32 %r0, [address];
    mov.u32 %r1, %tid.x;
    mad.lo.u32 %r2, %r1, 4, %r0;
    cvt.u64.u32 %rd3, %r2;
    ld.u32 %r3, [%rd3];
    mul.wide.u32 %rd1, %r1, 4;
    add.u64 %rd2, %rd0, %rd1;
    st.global.u32 [%rd2], %r3;
    ret;
}
