.version 8.8
.target sm_89
.address_size 64

.visible .entry vabsdiff4_probe(
 .param .u64 pa, .param .u64 pb, .param .u64 pc, .param .u64 po) {
 .reg .b64 %a0, %b0, %c0, %o0;
 .reg .b32 %a, %b, %c, %d0, %d1, %d2, %d3, %d4;
 ld.param.u64 %a0,[pa]; ld.param.u64 %b0,[pb]; ld.param.u64 %c0,[pc]; ld.param.u64 %o0,[po];
 ld.global.u32 %a,[%a0]; ld.global.u32 %b,[%b0]; ld.global.u32 %c,[%c0];
 vabsdiff4.u32.s32.u32 %d0,%a,%b,%c;
 vabsdiff4.s32.s32.s32 %d1,%a,%b,%c;
 vabsdiff4.u32.s32.u32.add %d2,%a,%b,%c;
 vabsdiff4.u32.s32.u32 %d3.b10,%a.b3210,%b.b7654,%c;
 vabsdiff4.u32.s32.u32.sat %d4,%a,%b,%c;
 st.global.u32 [%o0],%d0; st.global.u32 [%o0+4],%d1;
 st.global.u32 [%o0+8],%d2; st.global.u32 [%o0+12],%d3;
 st.global.u32 [%o0+16],%d4; ret;
}
