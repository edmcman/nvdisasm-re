.version 9.0
.target sm_100a
.address_size 64
.visible .entry f2fp_fp4_f32_downconvert(.param .u64 out, .param .u64 inp) {
    .reg .b64 %rd0, %rd1;
    .reg .b32 %r0, %r1, %r2;
    .reg .b8 %b0;
    ld.param.u64 %rd0, [out];
    ld.param.u64 %rd1, [inp];
    ld.global.b32 %r0, [%rd1];
    ld.global.b32 %r1, [%rd1+4];
    ld.global.b32 %r2, [%rd1+8];
    cvt.rn.satfinite.e2m1x2.f32 %b0, %r0, %r1;
    st.global.b8 [%rd0], %b0;
    ret;
}
