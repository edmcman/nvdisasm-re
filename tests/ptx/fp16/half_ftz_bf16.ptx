// sass: HADD2 HFMA2
.version 8.8
.target sm_89
.address_size 64

.visible .entry half_ftz_bf16(.param .u64 input, .param .u64 output) {
    .reg .b64 a, b, offset, source, dest;
    .reg .b32 x, y, z, r<6>, tid;
    ld.param.u64 a, [input];
    ld.param.u64 b, [output];
    mov.u32 tid, %tid.x;
    mul.wide.u32 offset, tid, 12;
    add.u64 source, a, offset;
    mul.wide.u32 offset, tid, 24;
    add.u64 dest, b, offset;
    ld.global.b32 x, [source];
    ld.global.b32 y, [source+4];
    ld.global.b32 z, [source+8];
    add.rn.ftz.f16x2 r0, x, y;
    add.rn.ftz.sat.f16x2 r1, x, y;
    fma.rn.ftz.f16x2 r2, x, y, z;
    fma.rn.ftz.sat.f16x2 r3, x, y, z;
    fma.rn.bf16x2 r4, x, y, z;
    fma.rn.relu.bf16x2 r5, x, y, z;
    st.global.b32 [dest], r0;
    st.global.b32 [dest+4], r1;
    st.global.b32 [dest+8], r2;
    st.global.b32 [dest+12], r3;
    st.global.b32 [dest+16], r4;
    st.global.b32 [dest+20], r5;
    ret;
}
