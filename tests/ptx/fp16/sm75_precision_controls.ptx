    mov.b32 {h2, h3}, r2;
    cvt.rz.f16.f32 h4, f0;
mov.b32 r4, {h4, h4};
fma.rn.f16x2 r15, r4, r1, r2;
    st.global.b32 [dest], r15;
    ret;
}

