// sass: HADD2
// Runtime inputs; compare implicit and explicit half rounding before widening.
.version 8.8
.target sm_75
.address_size 64

.visible .entry half_add_then_widen_implicit(.param .u64 input, .param .u64 output) {
    .reg .b64 a, b, offset, source, dest;
    .reg .b32 r<16>, tid;
    .reg .b16 h<16>;
    .reg .f32 f<16>;
    .reg .pred p, q;
    ld.param.u64 a, [input];
    ld.param.u64 b, [output];
    mov.u32 tid, %tid.x;
    mul.wide.u32 offset, tid, 16;
    add.u64 source, a, offset;
    mul.wide.u32 offset, tid, 4;
    add.u64 dest, b, offset;
    ld.global.v4.b32 {r0, r1, r2, r3}, [source];
    mov.b32 f0, r0;
    mov.b32 {h0, h1}, r1;
    mov.b32 {h2, h3}, r2;
    add.f16 h15, h0, h1;
    cvt.f32.f16 f3, h15;
    mov.b32 r15, f3;
    st.global.b32 [dest], r15;
    ret;
}

.visible .entry half_add_then_widen_rn(.param .u64 input, .param .u64 output) {
    .reg .b64 a, b, offset, source, dest;
    .reg .b32 r<16>, tid;
    .reg .b16 h<16>;
    .reg .f32 f<16>;
    .reg .pred p, q;
    ld.param.u64 a, [input];
    ld.param.u64 b, [output];
    mov.u32 tid, %tid.x;
    mul.wide.u32 offset, tid, 16;
    add.u64 source, a, offset;
    mul.wide.u32 offset, tid, 4;
    add.u64 dest, b, offset;
    ld.global.v4.b32 {r0, r1, r2, r3}, [source];
    mov.b32 f0, r0;
    mov.b32 {h0, h1}, r1;
    mov.b32 {h2, h3}, r2;
    add.rn.f16 h15, h0, h1;
    cvt.f32.f16 f3, h15;
    mov.b32 r15, f3;
    st.global.b32 [dest], r15;
    ret;
}
