.version 8.7
.target sm_100
.address_size 64
.visible .entry add_f32(.param .f32 a, .param .f32 b, .param .u64 out) {
.reg .f32 %r<3>; .reg .b64 %rd<1>;
ld.param.f32 %r0, [a]; ld.param.f32 %r1, [b]; ld.param.u64 %rd0, [out];
/* BEGIN_INSTRUCTION */ add.rn.f32 %r2, %r0, %r1; /* END_INSTRUCTION */ st.global.f32 [%rd0], %r2; ret;
}
