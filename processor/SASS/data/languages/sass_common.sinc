# Shared SASS definitions; tokens, fields and constructors are generated per arch into sass_smXX.slaspec.

define endian=little;
# Permit raw or embedded instructions at arbitrary addresses; each instruction is still 16 bytes.
define alignment=1;

define space ram      type=ram_space      size=8 default;
define space cbank    type=ram_space size=8;
define space shared   type=ram_space size=8;
define space localmem type=ram_space size=8;
define space register type=register_space size=4;

define register offset=0x1000 size=8 [ PC ];
